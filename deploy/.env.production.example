# ============================================================
# 云屿 YunYu · 生产环境配置模板
# 使用方式：复制为 .env 放在 backend/ 目录（或 systemd 中注入）
#   cp deploy/.env.production.example backend/.env.production
# 注意：生产环境【必须】覆盖以下所有安全敏感项，否则存在严重安全隐患！
# ============================================================

# ---- 运行模式（生产必须设为 production，关闭开发验证码回显）----
NODE_ENV=production
PORT=3000

# ---- 超级管理员「云屿岛主」----
# 【必须修改】生产环境绝不能使用默认密码
SUPER_ADMIN_EMAIL=admin@yunyu.app
SUPER_ADMIN_PASSWORD=请替换为高强度密码至少12位含大小写数字符号

# ---- JWT 密钥（【必须修改】用于签发登录令牌与验证码哈希）----
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为随机生成的64位十六进制字符串
JWT_EXPIRES_IN=7d

# ---- SMTP 邮件服务（注册/找回密码验证码发送，【建议配置】）----
# 未配置时验证码会回退为控制台打印，生产环境应配置真实邮箱服务
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_EMAIL=no-reply@example.com
SMTP_PASS=你的SMTP授权码
SMTP_FROM=云屿 <no-reply@example.com>